{
  "name": "axiom",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "axiom",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@axiom/client": {
      "resolved": "packages/client",
      "link": true
    },
    "node_modules/@axiom/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/@axiom/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@axiom/sim": {
      "resolved": "packages/sim",
      "link": true
    },
    "packages/client": {
      "name": "@axiom/client",
      "version": "0.1.0"
    },
    "packages/protocol": {
      "name": "@axiom/protocol",
      "version": "0.1.0"
    },
    "packages/server": {
      "name": "@axiom/server",
      "version": "0.1.0",
      "dependencies": {
        "@axiom/protocol": "0.1.0",
        "@axiom/sim": "0.1.0"
      }
    },
    "packages/sim": {
      "name": "@axiom/sim",
      "version": "0.1.0"
    }
  }
}

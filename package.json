{
  "name": "axiom",
  "private": true,
  "version": "0.1.0",
  "description": "Axiom: server-authoritative co-op raid game, the successor to Threshold.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node packages/server/src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "bots": "node tools/bots.js",
    "sim": "node tools/sim.js",
    "replay": "node tools/replay.js",
    "build": "node tools/build-client.js",
    "heroes": "node tools/import-heroes.js",
    "look": "node tools/import-look.js",
    "shots": "node tools/shots.js"
  }
}
